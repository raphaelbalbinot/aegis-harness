{
  "aegis-governance-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|multi_edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/aegis-hook-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
